# Single entrypoint for the browser.
#   /api/*                -> FastAPI backend
#   /<public bucket>/*    -> SeaweedFS (anonymous read)
#   /<private bucket>/*   -> SeaweedFS (signed URLs only; Host is preserved so signatures verify)
#   /*                    -> React frontend (Vite dev server in development)

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 20m;

    location /api/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/(${S3_BUCKET_PUBLIC}|${S3_BUCKET_PRIVATE})/ {
        limit_except GET HEAD { deny all; }
        proxy_pass http://seaweedfs:8333;
        proxy_set_header Host $http_host;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://frontend:5173;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
