# Copy to .env (make env) and adjust. Never commit .env.

# --- General -----------------------------------------------------------------
ENVIRONMENT=development
APP_PORT=8000
# Public URL the browser uses to reach the app (nginx). Used to build file URLs.
PUBLIC_BASE_URL=http://localhost:8000
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:8000,http://localhost:5173

# Optional: base map tile server for the web app (default: OpenStreetMap)
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# --- PostgreSQL / PostGIS ----------------------------------------------------
POSTGRES_DB=smartkids
POSTGRES_USER=smartkids
POSTGRES_PASSWORD=smartkids
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
# Database used by the automated tests (created by infra/postgres/initdb)
POSTGRES_TEST_DB=smartkids_test

# --- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- SeaweedFS (S3-compatible object storage) --------------------------------
# Keys must match infra/seaweedfs/s3.json
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_ACCESS_KEY=smartkids
S3_SECRET_KEY=smartkids-secret
S3_REGION=us-east-1
# Public bucket: educational images, article covers (served via nginx)
S3_BUCKET_PUBLIC=smartkids-public
# Private bucket: child photos, attachments (served only via short-lived signed URLs)
S3_BUCKET_PRIVATE=smartkids-private
S3_PRESIGNED_EXPIRE_SECONDS=900
SEAWEEDFS_MASTER_HOST_PORT=9333

# --- Email (Mailpit in development) ------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=no-reply@example.com
MAILPIT_HOST_PORT=8025

# --- Community health signal detection ---------------------------------------
# A signal is raised when the last SIGNAL_WINDOW_DAYS contain at least
# SIGNAL_MIN_REPORTS reports AND are SIGNAL_RATIO_THRESHOLD x the baseline rate.
SIGNAL_WINDOW_DAYS=7
SIGNAL_BASELINE_DAYS=28
SIGNAL_MIN_REPORTS=4
SIGNAL_RATIO_THRESHOLD=2.0
# Aggregates with fewer reports than this are suppressed (privacy, k-anonymity)
AGGREGATE_MIN_CELL_SIZE=3
